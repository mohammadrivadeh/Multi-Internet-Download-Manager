<Window x:Class="DownloadManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource AppTitle}" Width="900" Height="980" MinWidth="640" MinHeight="580" Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,6,10,6"/></Style>
        <Style TargetType="Label"><Setter Property="Padding" Value="0"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32">
            <TextBlock Text="{DynamicResource AppTitle}" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="{DynamicResource Subtitle}" Margin="0,8,0,24" FontSize="15"/>
            <StackPanel IsEnabled="{Binding IsReady}">
                <Label Content="{DynamicResource UrlLabel}" Target="{Binding ElementName=UrlInput}"/>
                <TextBox x:Name="UrlInput" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UrlLabel}"/>
                <Label Content="{DynamicResource DestinationLabel}" Target="{Binding ElementName=DestinationInput}"/>
                <DockPanel><Button Content="{DynamicResource BrowseLabel}" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"/><TextBox x:Name="DestinationInput" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource DestinationLabel}"/></DockPanel>
                <TextBlock Text="{DynamicResource ConnectionsLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <Button Content="{DynamicResource RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
                <ListBox ItemsSource="{Binding Paths}" MaxHeight="150" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" BorderThickness="0">
                    <ListBox.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" Padding="4"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <CheckBox IsChecked="{Binding UseSystemRoute}" Content="{DynamicResource SystemRouteLabel}" Margin="0,12"/>
                <Label Content="{DynamicResource WorkersLabel}" Target="{Binding ElementName=WorkersInput}"/>
                <TextBox x:Name="WorkersInput" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource WorkersLabel}"/>
                <Label Content="{DynamicResource ChecksumLabel}" Target="{Binding ElementName=ChecksumInput}"/>
                <TextBox x:Name="ChecksumInput" Text="{Binding ExpectedSha256, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource ChecksumLabel}"/>
                <Label Content="{DynamicResource SpeedLimitLabel}" Target="{Binding ElementName=SpeedLimitInput}"/>
                <TextBox x:Name="SpeedLimitInput" Text="{Binding SpeedLimitKiB, UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left"/>
                <Label Content="{DynamicResource PriorityLabel}" Target="{Binding ElementName=PriorityInput}"/>
                <TextBox x:Name="PriorityInput" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left"/>
                <Label Content="{DynamicResource ScheduleLabel}" Target="{Binding ElementName=ScheduleInput}"/>
                <TextBox x:Name="ScheduleInput" Text="{Binding ScheduledStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource ScheduleLabel}"/>
            </StackPanel>
            <WrapPanel IsEnabled="{Binding IsReady}">
                <Button Content="{DynamicResource AddLabel}" Command="{Binding AddCommand}"/>
                <Button Content="{DynamicResource RunQueueLabel}" Command="{Binding RunQueueCommand}"/>
                <Button Content="{DynamicResource PauseQueueLabel}" Command="{Binding PauseCommand}"/>
            </WrapPanel>
            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" IsIndeterminate="{Binding IsIndeterminate}" Height="12" Margin="0,16" AutomationProperties.Name="{DynamicResource ProgressLabel}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock Text="{DynamicResource QueueLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <DockPanel>
                <ComboBox SelectedValue="{Binding StateFilter}" SelectedValuePath="Tag" DockPanel.Dock="Right" Width="150" Margin="10,6,0,12">
                    <ComboBoxItem Content="{DynamicResource FilterAll}" Tag="All"/>
                    <ComboBoxItem Content="{DynamicResource FilterActive}" Tag="Active"/>
                    <ComboBoxItem Content="{DynamicResource QueueStateCompleted}" Tag="Completed"/>
                    <ComboBoxItem Content="{DynamicResource QueueStateFailed}" Tag="Failed"/>
                </ComboBox>
                <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource SearchLabel}"/>
            </DockPanel>
            <DataGrid ItemsSource="{Binding JobsView}" SelectedItem="{Binding SelectedJob}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Height="220" SelectionMode="Single" EnableRowVirtualization="True" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="{DynamicResource QueueLabel}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource FileColumn}" Binding="{Binding Filename}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource StateColumn}" Binding="{Binding State}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource ProgressLabel}" Binding="{Binding Progress}" Width="140"/>
                    <DataGridTextColumn Header="{DynamicResource SpeedLimitColumn}" Binding="{Binding RateLimit}" Width="100"/>
                    <DataGridTextColumn Header="{DynamicResource PriorityColumn}" Binding="{Binding Priority}" Width="70"/>
                    <DataGridTextColumn Header="{DynamicResource ScheduleColumn}" Binding="{Binding Schedule}" Width="180"/>
                    <DataGridTextColumn Header="{DynamicResource FailureColumn}" Binding="{Binding Failure}" Width="220"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel IsEnabled="{Binding IsReady}">
                <Button Content="{DynamicResource ResumeSelectedLabel}" Command="{Binding ResumeSelectedCommand}"/>
                <Button Content="{DynamicResource CancelSelectedLabel}" Command="{Binding CancelSelectedCommand}"/>
                <Button Content="{DynamicResource ClearHistoryLabel}" Command="{Binding ClearHistoryCommand}"/>
            </WrapPanel>
            <TextBlock Text="{DynamicResource ScheduleNote}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{DynamicResource ValidationNote}" TextWrapping="Wrap" Margin="0,20,0,0"/>
        </StackPanel>
    </ScrollViewer>
</Window>
