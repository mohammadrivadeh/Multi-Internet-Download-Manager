<UserControl x:Class="DownloadManager.App.Views.Sections.NewDownloadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="FocusUrl">
    <Border Background="{DynamicResource App.Surface}" BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.BorderSubtle}"
                    BorderThickness="0,0,0,1" MouseLeftButtonDown="DragHeader" Padding="18,8,8,8">
                <DockPanel>
                    <Button DockPanel.Dock="Right" IsCancel="True" Width="34" MinHeight="30" Padding="6,4" Margin="0"
                            ToolTip="Close" AutomationProperties.Name="Close">
                        <TextBlock Text="&#xE8BB;" FontFamily="{DynamicResource App.IconFont}"/>
                    </Button>
                    <TextBlock Text="{DynamicResource NewDownloadSectionLabel}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DockPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,12,20,14">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="IsEnabled" Value="{Binding IsReady}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AddCommand.IsRunning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Label Content="{DynamicResource UrlLabel}" Target="{Binding ElementName=UrlInput}"/>
                    <DockPanel Margin="0,4,0,10">
                        <Button DockPanel.Dock="Right" Click="PasteUrl" Margin="8,0,0,0" Width="48" MinHeight="48" Padding="0"
                                ToolTip="{DynamicResource PasteLinkLabel}" AutomationProperties.Name="{DynamicResource PasteLinkLabel}">
                            <TextBlock Text="&#xE77F;" FontFamily="{DynamicResource App.IconFont}" FontSize="18"/>
                        </Button>
                        <TextBox x:Name="UrlInput" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0"
                                 MinHeight="48" Padding="12,10" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource UrlLabel}"/>
                    </DockPanel>
                    <Label Content="{DynamicResource DestinationLabel}" Target="{Binding ElementName=DestinationInput}"/>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{DynamicResource BrowseLabel}" Command="{Binding BrowseCommand}"
                                Margin="8,0,0,0" MinHeight="48" Padding="12,5"/>
                        <TextBox x:Name="DestinationInput" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" MinHeight="48" Padding="12,10"
                                 Margin="0" VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource DestinationLabel}"/>
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Label Content="{DynamicResource CategoryLabel}" Target="{Binding ElementName=CategoryInput}"/>
                            <ComboBox x:Name="CategoryInput" ItemsSource="{Binding DownloadCategories}" DisplayMemberPath="Name"
                                      SelectedValuePath="Key" SelectedValue="{Binding Category, Mode=TwoWay}" Height="34"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <Label Content="{DynamicResource QueueAssignmentLabel}" Target="{Binding ElementName=QueueInput}"/>
                            <ComboBox x:Name="QueueInput" ItemsSource="{Binding Queues}" DisplayMemberPath="Name" SelectedValuePath="Name"
                                      SelectedValue="{Binding NewDownloadQueue, Mode=TwoWay}" Height="34"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding NewDownloadError}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                <Style.Triggers><DataTrigger Binding="{Binding NewDownloadError}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" Background="{DynamicResource App.SurfaceAlt}" BorderBrush="{DynamicResource App.BorderSubtle}"
                    BorderThickness="0,1,0,0" Padding="20,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0"/>
                    <Button IsDefault="True" Click="SubmitClick" Margin="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Setter Property="Content" Value="{DynamicResource StartDownloadLabel}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AddCommand.IsRunning}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource StartingDownloadLabel}"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
