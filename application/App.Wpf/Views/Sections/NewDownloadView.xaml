<UserControl x:Class="DownloadManager.App.Views.Sections.NewDownloadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="16">            <StackPanel IsEnabled="{Binding CanEditForm}">
                <Label Content="{DynamicResource UrlLabel}" Target="{Binding ElementName=UrlInput}"/>
                <TextBox x:Name="UrlInput" IsReadOnly="{Binding IsEditing}" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource UrlLabel}"/>
                <Expander Header="{DynamicResource DestinationRulesLabel}"><StackPanel>
                    <TextBox Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource DestinationRootLabel}"/>
                    <WrapPanel><Button Content="{DynamicResource ChooseRootLabel}" Command="{Binding ChooseRootCommand}"/><Button Content="{DynamicResource SuggestDestinationLabel}" Command="{Binding SuggestDestinationCommand}"/></WrapPanel>
                </StackPanel></Expander>
                <Label Content="{DynamicResource DestinationLabel}" Target="{Binding ElementName=DestinationInput}"/>
                <DockPanel><Button Content="{DynamicResource BrowseLabel}" Command="{Binding BrowseCommand}" DockPanel.Dock="Right"/><TextBox x:Name="DestinationInput" IsReadOnly="{Binding IsEditing}" Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource DestinationLabel}"/></DockPanel>
                <TextBlock Text="{DynamicResource ConnectionsLabel}" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,6"/>
                <Button Content="{DynamicResource RefreshLabel}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left"/>
                <ListBox ItemsSource="{Binding Paths}" MaxHeight="150" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" BorderThickness="0">
                    <ListBox.ItemTemplate><DataTemplate><DockPanel><TextBox DockPanel.Dock="Right" Width="76" Text="{Binding SpeedLimitKiB, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource PathSpeedLimitLabel}" AutomationProperties.Name="{DynamicResource PathSpeedLimitLabel}"/><CheckBox IsChecked="{Binding Selected}" Content="{Binding Label}" Padding="4"/></DockPanel></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <CheckBox IsChecked="{Binding UseSystemRoute}" Content="{DynamicResource SystemRouteLabel}" Margin="0,12"/>
                <CheckBox Content="{DynamicResource ReplaceConnectionsLabel}" IsChecked="{Binding ReplaceEditedConnections}" IsEnabled="{Binding IsEditing}" Margin="0,8"/>
                <Label Content="{DynamicResource WorkersLabel}" Target="{Binding ElementName=WorkersInput}"/>
                <TextBox x:Name="WorkersInput" Text="{Binding WorkerCount, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left" AutomationProperties.Name="{DynamicResource WorkersLabel}"/>
                <Label Content="{DynamicResource ChecksumLabel}" Target="{Binding ElementName=ChecksumInput}"/>
                <TextBox x:Name="ChecksumInput" IsReadOnly="{Binding IsEditing}" Text="{Binding ExpectedSha256, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource ChecksumLabel}"/>
                <Label Content="{DynamicResource SpeedLimitLabel}" Target="{Binding ElementName=SpeedLimitInput}"/>
                <TextBox x:Name="SpeedLimitInput" Text="{Binding SpeedLimitKiB, UpdateSourceTrigger=PropertyChanged}" Width="150" HorizontalAlignment="Left"/>
                <Label Content="{DynamicResource CategoryLabel}" Target="{Binding ElementName=CategoryInput}"/>
                <TextBox x:Name="CategoryInput" Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"/>
                <Label Content="{DynamicResource PriorityLabel}" Target="{Binding ElementName=PriorityInput}"/>
                <TextBox x:Name="PriorityInput" Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged}" Width="110" HorizontalAlignment="Left"/>
                <Expander Header="{DynamicResource DailyWindowLabel}"><StackPanel>
                    <Label Content="{DynamicResource WindowStartLabel}"/><TextBox Text="{Binding WindowStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource WindowStartLabel}"/>
                    <Label Content="{DynamicResource WindowEndLabel}"/><TextBox Text="{Binding WindowEnd, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource WindowEndLabel}"/>
                    <Label Content="{DynamicResource WindowOffsetLabel}"/><TextBox Text="{Binding WindowOffset, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource WindowOffsetLabel}"/>
                </StackPanel></Expander>
                <Label Content="{DynamicResource ScheduleLabel}" Target="{Binding ElementName=ScheduleInput}"/>
                <TextBox x:Name="ScheduleInput" Text="{Binding ScheduledStart, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource ScheduleLabel}"/>
            </StackPanel>
            <WrapPanel IsEnabled="{Binding IsReady}">
                <Button Content="{DynamicResource SaveDefaultsLabel}" Command="{Binding SaveDefaultsCommand}"/>
                <Button Content="{DynamicResource SaveEditedLabel}" Command="{Binding SaveEditedCommand}"/>
                <Button Content="{DynamicResource CancelEditLabel}" Command="{Binding CancelEditCommand}"/>
                <Button Content="{DynamicResource AddLabel}" Command="{Binding AddCommand}"/>
                <Button Content="{DynamicResource RunQueueLabel}" Command="{Binding RunQueueCommand}"/>
                <Button Content="{DynamicResource PauseQueueLabel}" Command="{Binding PauseCommand}"/>
            </WrapPanel>
</StackPanel></ScrollViewer></UserControl>
