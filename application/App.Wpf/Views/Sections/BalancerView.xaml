<UserControl x:Class="DownloadManager.App.Views.Sections.BalancerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded" IsVisibleChanged="OnVisibilityChanged">
    <Border Style="{StaticResource PanelCard}" Padding="20">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top">
                <WrapPanel>
                    <Button x:Name="StartCaptureButton" Content="Start system-wide balancing"
                            Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="StartCaptureClick"/>
                    <Button x:Name="StopCaptureButton" Content="Stop balancing"
                            IsEnabled="False" Visibility="Collapsed" Click="StopCaptureClick"/>
                    <Button x:Name="ScanButton" Content="Scan adapters" Click="ScanClick"/>
                </WrapPanel>
                <TextBlock x:Name="CaptureStatus" Text="Traffic capture is unavailable in this build."
                           Foreground="{DynamicResource App.TextMuted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Margin="0,8,0,0"/>
                <TextBlock x:Name="ScanStatus"
                           Foreground="{DynamicResource App.TextMuted}" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" Margin="0,8,0,12"/>
            </StackPanel>
            <DataGrid x:Name="AdapterTable" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" AutomationProperties.Name="Detected network adapters">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Use" Width="65">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding Eligible}" HorizontalAlignment="Center"
                                          AutomationProperties.Name="{Binding Adapter.Name, StringFormat='Use {0}'}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Adapter" Binding="{Binding Adapter.Name}" Width="*"/>
                    <DataGridTextColumn Header="IPv4" Binding="{Binding Adapter.IPv4}" Width="125"/>
                    <DataGridTextColumn Header="IPv6" Binding="{Binding Adapter.IPv6}" Width="190"/>
                    <DataGridTextColumn Header="Discovery status" Binding="{Binding Adapter.DiscoveryStatus}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
