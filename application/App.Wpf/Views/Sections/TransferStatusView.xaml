<UserControl x:Class="DownloadManager.App.Views.Sections.TransferStatusView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><StackPanel>            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percentage}" IsIndeterminate="{Binding IsIndeterminate}" Height="12" Margin="0,16" AutomationProperties.Name="{DynamicResource ProgressLabel}"/>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" FontSize="14"/>
            <TextBlock Text="{DynamicResource ScheduleNote}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <TextBlock Text="{DynamicResource ValidationNote}" TextWrapping="Wrap" Margin="0,20,0,0"/>
</StackPanel></UserControl>
