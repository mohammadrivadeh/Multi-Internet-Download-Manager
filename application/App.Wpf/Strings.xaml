    <sys:String x:Key="ScheduleColumn">Start at</sys:String>
    <sys:String x:Key="ResumeSelectedLabel">Requeue paused / failed</sys:String>
    <sys:String x:Key="CancelSelectedLabel">Cancel pending entry</sys:String>
    <sys:String x:Key="ClearHistoryLabel">Clear completed / cancelled history</sys:String>
    <sys:String x:Key="ScheduleNote">Scheduled jobs run only while the app is open and the queue is started. Stopping the queue disables scheduled starts. Cancelling entries or clearing history never deletes downloaded or partial files.</sys:String>
    <sys:String x:Key="QueueLoadError">Queue storage is unavailable, protected by another account, or already open in another app instance. Existing data is preserved.</sys:String>
    <sys:String x:Key="QueueSaveError">The queue could not be saved. Stop and check access and disk space; existing files are preserved.</sys:String>
    <sys:String x:Key="AddedStatus">Added to queue. Start the queue to process ready jobs.</sys:String>
    <sys:String x:Key="QueueInputError">Check the URL, destination, selected paths, checksum, workers, priority and schedule. A scheduled time must include an offset, for example 2026-11-15T09:00:00+03:30.</sys:String>
    <sys:String x:Key="QueueConflictError">Another unfinished job owns this destination, or the queue is full. Clear terminal history or choose another destination.</sys:String>
    <sys:String x:Key="QueueActionError">This action is unavailable in the selected state. Stop the queue and wait for the active job to pause first.</sys:String>
    <sys:String x:Key="QueueWaitingStatus">Ready jobs processed. The started queue will check for scheduled work while the app remains open.</sys:String>
    <sys:String x:Key="FailureColumn">Issue</sys:String>
    <sys:String x:Key="QueueFailureValidation">Response, saved data or checksum mismatch</sys:String>
    <sys:String x:Key="QueueFailureNetwork">Server or connection failure</sys:String>
    <sys:String x:Key="QueueFailureStorage">Check destination access and disk space</sys:String>
    <sys:String x:Key="QueueFailureTimeout">Response timed out</sys:String>
    <sys:String x:Key="QueueFailureFailure">Review connections and job settings</sys:String>
</ResourceDictionary>
